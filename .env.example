# ───────── Required ─────────
DATABASE_URL="postgresql://reset:reset_dev@localhost:5432/reset?schema=public"
# 32+ random characters. Signs file URLs and encrypts integration secrets. Generate: openssl rand -base64 48
APP_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Public base URL (used in emails, PDFs and absolute links)
APP_URL="http://localhost:3000"

# ───────── Site mode ─────────
# "demo" shows a clearly labelled sample catalogue, sample services and draft health articles, and tells search engines to stay away.
# "live" shows only real, confirmed content. Use "live" for the public site.
SITE_MODE="live"

# ───────── Payments (Paystack) ─────────
# Secret key from the Paystack dashboard: sk_test_… while testing, sk_live_… only after Paystack has approved the business.
# Empty = card payments are unavailable. A key saved in Admin > Integrations > Paystack takes precedence over this one.
PAYSTACK_SECRET_KEY=""
# Leave as is. (Only automated tests point this at a local stand-in.)
PAYSTACK_API_BASE="https://api.paystack.co"

# ───────── Email (pick one provider; with none set, messages are recorded in the outbox as SKIPPED) ─────────
EMAIL_FROM="Reset Pharmacy <desk@example.com>"
# Option 1: Resend
RESEND_API_KEY=""
# Option 2: SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"

# ───────── Files ─────────
# Private storage root. Must NOT be inside /public. Mount a persistent volume here in production.
STORAGE_DIR="./storage"

# ───────── Background jobs ─────────
# Shared secret for POST /api/jobs/run (call it from a scheduler every minute). Leave empty to disable the endpoint.
CRON_SECRET=""

# ───────── Behaviour ─────────
# "true" (default) requires customers to verify their email before using the portal
AUTH_REQUIRE_EMAIL_VERIFICATION="true"
# Set "true" only when the site sits behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY="false"

# ───────── Upload scanning ─────────
# Address of a ClamAV daemon (clamd). Empty = built-in file checks only.
CLAMAV_HOST=""
CLAMAV_PORT="3310"
